{
  "schemaVersion": 1,
  "id": "io.github.workingtitle.gestures",
  "name": "Swipe Control",
  "version": "1.0.0",
  "author": "workingtitle",
  "license": "MIT",
  "description": "macOS-style trackpad control for Omarchy: 1:1 workspace swipes, Mission Control with live previews on swipe up, a Control Center-style swipe through the bar's popups, and Shift + swipe to carry windows between workspaces.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Swipe Control",
    "description": "Trackpad gestures, Mission Control and bar popup navigation, with a settings popup",
    "category": "Desktop",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "threeFingers": true,
      "fourFingers": false,
      "workspaceSwipe": true,
      "stopAtLastWorkspace": true,
      "swipeUpExpose": true,
      "swipeDownPanels": true,
      "startPanel": "last",
      "windowSwipe": true,
      "popupArrowKeys": true
    },
    "schema": [
      {
        "key": "threeFingers",
        "type": "boolean",
        "label": "Three-finger gestures",
        "defaultValue": true
      },
      {
        "key": "fourFingers",
        "type": "boolean",
        "label": "Four-finger gestures",
        "defaultValue": false
      },
      {
        "key": "workspaceSwipe",
        "type": "boolean",
        "label": "Swipe between workspaces",
        "defaultValue": true
      },
      {
        "key": "stopAtLastWorkspace",
        "type": "boolean",
        "label": "Stop at the last workspace",
        "defaultValue": true
      },
      {
        "key": "swipeUpExpose",
        "type": "boolean",
        "label": "Swipe up opens Mission Control",
        "defaultValue": true
      },
      {
        "key": "swipeDownPanels",
        "type": "boolean",
        "label": "Swipe down opens bar popups",
        "defaultValue": true
      },
      {
        "key": "startPanel",
        "type": "string",
        "label": "Popup to open: last or first",
        "defaultValue": "last"
      },
      {
        "key": "windowSwipe",
        "type": "boolean",
        "label": "Shift + swipe moves the focused window to the next workspace",
        "defaultValue": true
      },
      {
        "key": "popupArrowKeys",
        "type": "boolean",
        "label": "While a bar popup is open, Super + left/right switch popups instead of window focus",
        "defaultValue": true
      }
    ]
  }
}
